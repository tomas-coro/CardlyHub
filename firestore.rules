rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function maxPlayers(game) {
      return game == 'briscola' ? 4
        : game == 'machiavelli' ? 6
        : game == 'uno' ? 10
        : game == 'burraco' ? 2
        : game == 'dadi' ? 6
        : 0;
    }

    function validPlayer(player, userId, seat) {
      return player.keys().hasOnly(['user_id', 'seat', 'name'])
        && player.user_id == userId
        && player.seat == seat
        && player.name is string
        && player.name.size() >= 1
        && player.name.size() <= 24;
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /rooms/{roomCode} {
      allow read: if signedIn();
      allow create: if signedIn()
        && roomCode.matches('^[A-HJ-NP-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['code', 'game', 'host_id', 'status', 'players', 'created_at'])
        && request.resource.data.code == roomCode
        && request.resource.data.host_id == request.auth.uid
        && request.resource.data.status == 'waiting'
        && maxPlayers(request.resource.data.game) > 0
        && request.resource.data.players.keys().hasOnly([request.auth.uid])
        && validPlayer(request.resource.data.players[request.auth.uid], request.auth.uid, 0);
      allow update: if signedIn()
        && resource.data.status == 'waiting'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players'])
        && request.resource.data.players.diff(resource.data.players).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.players.size() <= maxPlayers(resource.data.game)
        && validPlayer(
          request.resource.data.players[request.auth.uid],
          request.auth.uid,
          request.auth.uid in resource.data.players
            ? resource.data.players[request.auth.uid].seat
            : resource.data.players.size()
        )
        && (request.auth.uid in resource.data.players
          ? request.resource.data.players.size() == resource.data.players.size()
          : request.resource.data.players.size() == resource.data.players.size() + 1);
    }
  }
}
