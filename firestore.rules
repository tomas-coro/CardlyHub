rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function pairMember(pairId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/pairs/$(pairId)).data.members;
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /pairs/{pairId} {
      allow read: if signedIn()
        && (request.auth.uid in resource.data.members || resource.data.members.size() == 1);
      allow create: if signedIn()
        && pairId == request.auth.uid
        && request.resource.data.keys().hasOnly(['members', 'names', 'created_at'])
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.names.keys().hasOnly([request.auth.uid]);
      allow update: if signedIn()
        && resource.data.members.size() == 1
        && !(request.auth.uid in resource.data.members)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names'])
        && request.resource.data.members.size() == 2
        && request.resource.data.members.hasAll(resource.data.members)
        && request.auth.uid in request.resource.data.members
        && request.resource.data.names.keys().hasOnly(request.resource.data.members);

      match /invites/{inviteId} {
        allow read: if pairMember(pairId);
        allow create, update: if pairMember(pairId)
          && request.resource.data.game in ['briscola', 'machiavelli', 'uno', 'burraco', 'dadi']
          && request.resource.data.host_id in get(/databases/$(database)/documents/pairs/$(pairId)).data.members
          && request.resource.data.guest_id in get(/databases/$(database)/documents/pairs/$(pairId)).data.members
          && request.resource.data.host_id != request.resource.data.guest_id
          && request.resource.data.status in ['pending', 'accepted', 'closed'];
      }
    }
  }
}
